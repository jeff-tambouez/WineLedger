<?xml version="1.0" encoding="utf-8"?>
<!--
    Android backup of the app's private data (Android 12 and up; minSdk is 34).

    Cloud backup (Google account, about once a day, restored when the app is installed again):
    the database and the preferences only. Google caps an app at 25 MB and drops the whole backup
    above that, so the photos stay out: they are in the full backup ZIP and the weekly automatic ZIP.

    Device transfer (moving to a new phone with a cable or the transfer app): everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="wineledger.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="wineledger.xml" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>

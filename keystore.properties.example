# Copy this file to keystore.properties (same folder, never committed) and fill it in.
# To keep updating the app already on the phone, point it at the key that signed it:
# the debug key of the computer that built it, usually ~/.android/debug.keystore
# (Windows: C:\Users\<you>\.android\debug.keystore). Keep a copy of that file somewhere safe.
storeFile=/absolute/path/to/debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
